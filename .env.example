export YC_SERVICE_ACCOUNT_KEY_FILE="/path/to/authorized_key.json"
export YC_CLOUD_ID="your-cloud-id"
export YC_FOLDER_ID="your-folder-id"

export TF_CLI_CONFIG_FILE="$HOME/terraform-lab/terraformrc"

export TF_VAR_zone="ru-central1-a"
export TF_VAR_ssh_user="your-user"
export TF_VAR_ssh_public_key_1="$(cat $HOME/.ssh/key1.pub)"
export TF_VAR_ssh_public_key_2="$(cat $HOME/.ssh/key2.pub)"
